# ── 对外访问 ─────────────────────────────────────────────────────────
# 客户端访问用的主机名或 IP。
#   IP   → Caddy 用内部 CA 签自签证书，客户端需信任一次根证书
#   域名 → 改用 Caddyfile.domain，自动申请 Let's Encrypt 证书
#
# 留空即可：./setup.sh 会自动识别公网 IP 填进来
SITE_HOST=

# Caddy 模式：edge = IP + 内部 CA；domain = 域名 + Let's Encrypt
# domain 模式还需要 docker-compose.domain.yml（setup.sh 会自动带上）
CADDY_MODE=edge

# HTTPS 端口（宿主机和容器用同一个端口号）。
#   8443 = 访问 https://IP:8443
#   443  = 访问 https://IP（不带端口），前提是 443 没被别的服务占用
# 注意：80/443 已被 nginx / nps / 宝塔 等占用时，容器会启动失败起不来
EDGE_PORT=8443

# 宿主机映射到 app 容器的端口，只绑 127.0.0.1，需要时用 SSH 隧道访问
HOST_PORT=48080

# ── 应用参数 ─────────────────────────────────────────────────────────
# 频道无上传多久后过期（秒），范围 60–86400
CHANNEL_TTL_SECONDS=1800

# 后台清理过期频道的间隔（秒），范围 10–3600
CLEANUP_INTERVAL_SECONDS=60

# 每频道每秒最大上传次数，范围 1–100
UPLOAD_RATE_LIMIT=2

# 每频道最大观看者数，范围 1–500
MAX_VIEWERS_PER_CHANNEL=50

# 单次上传文本最大字符数，范围 1–10000
MAX_TEXT_LENGTH=2000

# 分享码位数，4–12。越短越好念，但可猜测空间越小（8 位 = 1 亿种）
SHARE_CODE_LENGTH=8

# 同时存在的频道上限，防止内存被打满
MAX_CHANNELS=1000

# 每个频道保留多少条历史记录
MAX_HISTORY=200

# 每个 IP 每分钟允许查询/连接多少次（防止穷举分享码）
VERIFY_RATE_LIMIT=60

# 是否信任反向代理传来的 X-Forwarded-For。
# 走 Caddy 访问时必须为 true，否则所有请求会被当成同一个 IP
TRUST_PROXY=true

# ── 域名模式额外需要（用 Caddyfile.domain 时）────────────────────────
# ACME 通知邮箱，证书快过期时会收到提醒
ACME_EMAIL=you@example.com

# ── 发布 ─────────────────────────────────────────────────────────────
# ./publish.sh 不带参数时用这个地址推送
# 注意 ACR 个人版用的是专属域名 crpi-xxx.<region>.personal.cr.aliyuncs.com，
# 不是老式的 registry.<region>.aliyuncs.com
PUBLISH_IMAGE=crpi-xqw99hsrxtt1g9fq.cn-beijing.personal.cr.aliyuncs.com/liveqrcode/live-qrcode
