# 域名模式：把 docker-compose.yml 里的 ./Caddyfile.edge 换成 ./Caddyfile.domain
#
# 用这个文件前确认：
#   1) 域名的 A 记录已指向本机
#   2) 阿里云安全组放行 80 和 443（80 用于证书验证和跳转）
#   3) 大陆节点需要 ICP 备案，否则 80/443 会被阻断
#   4) compose 里 edge 的端口映射改成 "80:80" 和 "443:443"
#
# 注意：这里刻意不写全局 email 块。
#   Caddy 的 {$VAR:默认值} 语法只在变量【未设置】时用默认值；
#   变量存在但值为空时会被替换成空字符串，导致 `email` 没有参数而解析失败。
#   ACME 邮箱是可选的，不影响证书签发。

{$SITE_HOST:qr.example.com} {
	encode gzip zstd

	reverse_proxy app:3000 {
		flush_interval -1
	}
}
